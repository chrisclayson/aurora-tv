<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Aurora · On-TV configuration</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23234bd8'/%3E%3Ctext x='16' y='23' font-family='Arial' font-size='20' font-weight='700' fill='white' text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="ambient" aria-hidden="true"></div>

  <header class="topbar">
    <div class="brand">
      <span class="mark">A</span>
      <div class="brand-text">
        <strong>AURORA</strong>
        <small>On-TV configuration</small>
      </div>
    </div>
    <div class="top-actions">
      <span class="pill" id="dirty-pill" hidden><span class="dot warn"></span><span>Unsaved changes</span></span>
      <span class="pill" id="server-pill"><span class="dot"></span><span id="server-text">Connecting…</span></span>
      <button class="btn ghost small" id="token-btn" type="button">Access token</button>
      
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="side-head">
        <span>Devices</span>
        
      </div>
      <div id="device-list" class="device-list"></div>
      <div class="side-note">
        Choose a TV, edit its settings, then save. Aurora polls this server; after
        the first bootstrap, no rebuild or reinstall is needed.
      </div>
    </aside>

    <main class="main">
      <div class="editor-head">
        <div class="editor-title">
          <p class="eyebrow">DEVICE CONFIGURATION</p>
          <h1 id="device-title">Loading…</h1>
          <p class="meta" id="device-meta"></p>
        </div>
        <div class="head-actions">
          
          <button id="download-config" class="btn ghost small" type="button">Download config.json</button>
          <button id="revert" class="btn ghost small" type="button">Revert</button>
          <button id="save" class="btn primary" type="button">Save changes</button>
        </div>
      </div>

      <div class="dirty" id="dirty" hidden>Unsaved changes</div>
      <div class="banner error" id="error-banner" hidden></div>

      <form id="form" autocomplete="off"></form>

      <div class="empty" id="empty" hidden>
        <h2>No devices yet</h2>
        <p>Add a device to create its configuration.</p>
        <button class="btn primary" id="empty-add" type="button">Add device</button>
      </div>
    </main>
  </div>

  <div id="toast-host" aria-live="polite"></div>

  <div class="modal-backdrop" id="token-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="token-title">
      <h2 id="token-title">Server access token</h2>
      <p class="modal-copy">
        This configuration server is protected by <code>AURORA_CONFIG_TOKEN</code>.
        Enter the token to read and write TV configurations. It is kept in this
        browser tab only.
      </p>
      <label class="field">
        <span>Token</span>
        <input id="token-input" type="password" autocomplete="off" spellcheck="false" placeholder="Paste the token">
      </label>
      <p class="form-error" id="token-error" hidden></p>
      <div class="modal-actions">
        <button class="btn ghost" id="token-cancel" type="button">Cancel</button>
        <button class="btn primary" id="token-save" type="button">Unlock</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="device-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="new-device-title">
      <h2 id="new-device-title">Add a device</h2>
      <p class="modal-copy">Create a new TV profile. It starts as a copy of an existing profile.</p>
      <div class="modal-grid">
        <label class="field">
          <span>Device ID</span>
          <input id="new-id" type="text" placeholder="living-room" autocomplete="off" spellcheck="false">
          <small>Lowercase letters, numbers, hyphen and underscore. Use the same ID in each TV's remote config URL.</small>
        </label>
        <label class="field">
          <span>Name</span>
          <input id="new-name" type="text" placeholder="Living Room" autocomplete="off">
        </label>
        <label class="field">
          <span>Model</span>
          <input id="new-model" type="text" placeholder="QE50QN90CATXXU" autocomplete="off">
        </label>
        <label class="field">
          <span>Copy from</span>
          <select id="new-copy"></select>
        </label>
      </div>
      <p class="form-error" id="new-error" hidden></p>
      <div class="modal-actions">
        <button class="btn ghost" id="new-cancel" type="button">Cancel</button>
        <button class="btn primary" id="new-save" type="button">Create device</button>
      </div>
    </div>
  </div>

  <script>window.AURORA_LOCAL_SERVER = true;</script>
  <script src="app.js"></script>
</body>
</html>
/* Aurora remote configuration — no external assets. */
:root {
  --bg: #07090f;
  --panel: rgba(255, 255, 255, 0.045);
  --panel-strong: rgba(255, 255, 255, 0.075);
  --line: rgba(255, 255, 255, 0.1);
  --ink: #f5f7fc;
  --muted: rgba(245, 247, 252, 0.55);
  --faint: rgba(245, 247, 252, 0.34);
  --accent: #7aa2ff;
  --accent-2: #b49cff;
  --good: #4ade80;
  --bad: #fb7185;
  --radius: 18px;
  --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
}

* { box-sizing: border-box; }

[hidden] { display: none !important; }

html, body { min-height: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: 15px;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -2;
  background: #07090f;
}

.ambient {
  position: fixed;
  inset: -20% -10% auto -10%;
  height: 90vh;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(42% 55% at 18% 18%, rgba(53, 96, 224, 0.38), transparent 70%),
    radial-gradient(38% 50% at 78% 8%, rgba(190, 102, 48, 0.2), transparent 70%),
    radial-gradient(40% 55% at 82% 82%, rgba(32, 156, 140, 0.16), transparent 70%);
  filter: blur(20px);
}

a { color: var(--accent); }

code {
  font-family: "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace;
  font-size: 0.9em;
  background: rgba(255, 255, 255, 0.07);
  padding: 2px 5px;
  border-radius: 5px;
}

/* ---------- top bar ---------- */

.topbar {
  height: 76px;
  padding: 0 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(7, 9, 15, 0.7);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand { display: flex; align-items: center; gap: 13px; }

.mark {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: linear-gradient(150deg, #ffffff, #b9c8ff);
  color: #080b12;
  font-weight: 800;
  font-size: 18px;
  box-shadow: 0 8px 24px rgba(100, 140, 255, 0.25);
}

.brand-text { display: flex; flex-direction: column; line-height: 1.15; }
.brand-text strong { font-size: 12px; letter-spacing: 0.3em; font-weight: 700; color: rgba(255, 255, 255, 0.82); }
.brand-text small { font-size: 11px; color: var(--faint); margin-top: 3px; }

.top-actions { display: flex; align-items: center; gap: 12px; }

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 30px;
  padding: 0 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.055);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 11px;
  color: var(--muted);
  white-space: nowrap;
}

.dot { width: 7px; height: 7px; border-radius: 50%; background: #6b7280; }
.pill.ok .dot { background: var(--good); box-shadow: 0 0 10px rgba(74, 222, 128, 0.7); }
.pill.bad .dot { background: var(--bad); }
.pill .dot.warn { background: #fbbf24; box-shadow: 0 0 10px rgba(251, 191, 36, 0.5); }

/* ---------- layout ---------- */

.layout {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  min-height: calc(100vh - 76px);
}

.sidebar {
  padding: 26px 20px;
  border-right: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.018);
  position: sticky;
  top: 76px;
  align-self: start;
  height: calc(100vh - 76px);
  overflow-y: auto;
}

.side-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6px 12px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--faint);
}

.icon-btn {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
  color: var(--ink);
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s var(--ease);
}
.icon-btn:hover { background: rgba(255, 255, 255, 0.13); transform: translateY(-1px); }

.device-list { display: flex; flex-direction: column; gap: 6px; }

.device-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 12px;
  border: 1px solid transparent;
  border-radius: 13px;
  background: transparent;
  color: var(--ink);
  text-align: left;
  font-family: inherit;
  cursor: pointer;
  transition: background 0.18s, border-color 0.18s;
}
.device-item:hover { background: rgba(255, 255, 255, 0.05); }
.device-item.active {
  background: rgba(122, 162, 255, 0.11);
  border-color: rgba(122, 162, 255, 0.3);
}
.device-avatar {
  flex: none;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, rgba(122, 162, 255, 0.35), rgba(180, 156, 255, 0.16));
  font-size: 13px;
  font-weight: 700;
  color: #e8eeff;
}
.device-copy { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.device-name { font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.device-model { font-size: 10.5px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.side-note {
  margin-top: 22px;
  padding: 14px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 11.5px;
  line-height: 1.55;
  color: var(--faint);
}

.main { padding: 32px 40px 90px; min-width: 0; }

.editor-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  max-width: 1080px;
  margin: 0 auto 18px;
}

.eyebrow {
  margin: 0 0 7px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--faint);
}

.editor-head h1 {
  margin: 0;
  font-size: 38px;
  letter-spacing: -0.035em;
  line-height: 1.05;
  font-weight: 700;
}

.meta { margin: 8px 0 0; font-size: 12.5px; color: var(--muted); }

.head-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }

/* ---------- buttons ---------- */

.btn {
  height: 38px;
  padding: 0 16px;
  border-radius: 10px;
  border: 1px solid transparent;
  font-family: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.08);
  transition: background 0.18s, transform 0.18s var(--ease), border-color 0.18s;
  white-space: nowrap;
}
.btn:hover { background: rgba(255, 255, 255, 0.14); transform: translateY(-1px); }
.btn:disabled { opacity: 0.5; cursor: default; transform: none; }
.btn.primary {
  background: linear-gradient(135deg, #f7f8ff, #dce6ff);
  color: #080b12;
  box-shadow: 0 10px 30px rgba(120, 150, 255, 0.18);
}
.btn.primary:hover { background: #fff; }
.btn.ghost { background: rgba(255, 255, 255, 0.055); border-color: rgba(255, 255, 255, 0.1); }
.btn.small { height: 32px; padding: 0 12px; font-size: 11.5px; border-radius: 9px; }
.btn.danger { color: #ffc2cb; }
.btn.danger:hover { background: rgba(251, 113, 133, 0.14); }

.dirty {
  max-width: 1080px;
  margin: 0 auto 14px;
  padding: 9px 13px;
  border-radius: 10px;
  font-size: 12px;
  color: #fde68a;
  background: rgba(251, 191, 36, 0.08);
  border: 1px solid rgba(251, 191, 36, 0.18);
}

.banner {
  max-width: 1080px;
  margin: 0 auto 14px;
  padding: 11px 14px;
  border-radius: 11px;
  font-size: 12.5px;
  line-height: 1.5;
}
.banner.error { color: #fecdd3; background: rgba(251, 113, 133, 0.08); border: 1px solid rgba(251, 113, 133, 0.2); }

/* ---------- form cards ---------- */

#form { max-width: 1080px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }

.card {
  border-radius: var(--radius);
  border: 1px solid rgba(255, 255, 255, 0.085);
  background: rgba(255, 255, 255, 0.035);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  overflow: hidden;
}

.card-head {
  padding: 20px 22px 0;
}
.card-head h2 { margin: 0; font-size: 17px; letter-spacing: -0.015em; font-weight: 650; }
.card-head p { margin: 5px 0 0; font-size: 12px; line-height: 1.5; color: var(--faint); }

.card-body { padding: 18px 22px 22px; }

.grid { display: grid; gap: 14px; }
.grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.span-2 { grid-column: span 2; }

/* ---------- fields ---------- */

.field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.field > span {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--faint);
}
.field input, .field select {
  height: 40px;
  width: 100%;
  padding: 0 12px;
  border-radius: 9px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(4, 6, 12, 0.45);
  color: var(--ink);
  font-family: inherit;
  font-size: 13.5px;
  outline: none;
  transition: border-color 0.18s, box-shadow 0.18s;
}
.field input::placeholder { color: rgba(255, 255, 255, 0.24); }
.field input:focus, .field select:focus {
  border-color: rgba(122, 162, 255, 0.7);
  box-shadow: 0 0 0 3px rgba(122, 162, 255, 0.12);
}
.field small { font-size: 11px; line-height: 1.45; color: rgba(255, 255, 255, 0.34); }
.field small.warn { color: #fbbf24; }

.field-row {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 42px;
}

/* switch */
.switch { position: relative; display: inline-flex; flex: none; width: 44px; height: 25px; }
.switch input { position: absolute; opacity: 0; width: 0; height: 0; }
.switch-track {
  width: 44px;
  height: 25px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  transition: background 0.2s;
  cursor: pointer;
}
.switch-track::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  background: #8d96a8;
  transition: transform 0.2s var(--ease), background 0.2s;
}
.switch input:checked + .switch-track { background: rgba(74, 222, 128, 0.32); }
.switch input:checked + .switch-track::after { transform: translateX(19px); background: #ecfff3; }
.switch input:focus + .switch-track { box-shadow: 0 0 0 3px rgba(122, 162, 255, 0.2); }

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 12px 14px;
  border-radius: 11px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.025);
}
.toggle-copy { min-width: 0; }
.toggle-copy b { display: block; font-size: 13px; font-weight: 600; }
.toggle-copy small { display: block; margin-top: 3px; font-size: 11px; color: var(--faint); }

/* source cards */
.source {
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 13px;
  padding: 14px;
  background: rgba(255, 255, 255, 0.02);
}
.source + .source { margin-top: 10px; }
.source-head { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; }
.source-tag {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.14em;
  padding: 4px 7px;
  border-radius: 6px;
  background: rgba(122, 162, 255, 0.14);
  color: #bcd0ff;
}
.source-head strong { font-size: 13px; font-weight: 600; }

/* dashboard rows */
.dash-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1.4fr auto;
  gap: 8px;
  align-items: center;
}
.dash-row + .dash-row { margin-top: 8px; }
.dash-row input {
  height: 36px;
  width: 100%;
  padding: 0 10px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(4, 6, 12, 0.45);
  color: var(--ink);
  font-family: inherit;
  font-size: 12.5px;
  outline: none;
}
.dash-row input:focus { border-color: rgba(122, 162, 255, 0.65); }
.remove-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.55);
  cursor: pointer;
  font-size: 16px;
  line-height: 1;
}
.remove-btn:hover { color: #fecdd3; background: rgba(251, 113, 133, 0.12); }

.inline-actions { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-top: 10px; }
.test-result { font-size: 11.5px; color: var(--faint); }
.test-result.ok { color: var(--good); }
.test-result.bad { color: var(--bad); }

.section-note {
  font-size: 11.5px;
  line-height: 1.55;
  color: var(--faint);
  margin: 12px 0 0;
}

/* remote bootstrap */
.bootstrap {
  margin-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  padding-top: 14px;
}
.bootstrap summary {
  cursor: pointer;
  font-size: 11.5px;
  color: var(--muted);
  user-select: none;
}
.bootstrap pre {
  margin: 10px 0 0;
  padding: 13px 14px;
  border-radius: 10px;
  background: rgba(3, 5, 10, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.07);
  overflow-x: auto;
  font-size: 11.5px;
  line-height: 1.5;
  color: rgba(230, 238, 255, 0.8);
}
.bootstrap .inline-actions { margin-top: 8px; }

.footer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding: 4px 0 20px;
}

/* ---------- empty ---------- */

.empty { max-width: 520px; margin: 10vh auto; text-align: center; color: var(--muted); }
.empty h2 { color: var(--ink); margin-bottom: 6px; }
.empty p { margin-bottom: 18px; }

/* ---------- toast ---------- */

#toast-host {
  position: fixed;
  left: 50%;
  bottom: 30px;
  transform: translateX(-50%);
  z-index: 90;
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: center;
  pointer-events: none;
}
.toast {
  padding: 11px 15px;
  border-radius: 10px;
  background: rgba(14, 18, 28, 0.94);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(18px);
  font-size: 12.5px;
  color: rgba(255, 255, 255, 0.88);
  animation: toastIn 0.24s var(--ease);
  transition: opacity 0.3s, transform 0.3s;
  max-width: 520px;
  text-align: center;
}
.toast.ok { border-color: rgba(74, 222, 128, 0.28); }
.toast.bad { border-color: rgba(251, 113, 133, 0.32); }
.toast.leaving { opacity: 0; transform: translateY(6px); }

/* ---------- modals ---------- */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(3, 5, 10, 0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.modal-backdrop[hidden] { display: none; }

.modal {
  width: min(560px, 94vw);
  padding: 26px;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: #0d111b;
  box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6);
  animation: rise 0.24s var(--ease);
}
.modal h2 { margin: 0 0 8px; font-size: 22px; letter-spacing: -0.025em; }
.modal-copy { margin: 0 0 18px; font-size: 12.5px; line-height: 1.55; color: var(--muted); }
.modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.modal-grid .field:nth-child(1), .modal-grid .field:nth-child(4) { grid-column: span 2; }
.modal-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 20px; }
.form-error { margin: 12px 0 0; font-size: 12px; color: #fecdd3; }

@keyframes rise {
  from { opacity: 0; transform: translateY(10px) scale(0.99); }
  to { opacity: 1; transform: none; }
}
@keyframes toastIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: none; }
}

/* ---------- responsive ---------- */

@media (max-width: 1000px) {
  .layout { grid-template-columns: 230px minmax(0, 1fr); }
  .main { padding: 26px 24px 70px; }
  .editor-head { align-items: flex-start; flex-direction: column; }
  .head-actions { justify-content: flex-start; }
  .grid.three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 760px) {
  .sidebar { position: static; height: auto; }
  .topbar { padding: 0 16px; }
  .brand-text small { display: none; }
  .layout { display: block; }
  .sidebar { border-right: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.07); padding: 16px; }
  .device-list { flex-direction: row; overflow-x: auto; padding-bottom: 4px; }
  .device-item { min-width: 190px; }
  .side-note { display: none; }
  .main { padding: 22px 16px 70px; }
  .grid.two, .grid.three { grid-template-columns: 1fr; }
  .span-2 { grid-column: auto; }
  .dash-row { grid-template-columns: 1fr 1fr; }
  .dash-row .remove-btn { grid-column: span 2; justify-self: end; }
  .modal-grid { grid-template-columns: 1fr; }
  .modal-grid .field { grid-column: auto; }
  .editor-head h1 { font-size: 30px; }
  #toast-host { width: 90vw; }
}

/* ---------- Home Assistant entity picker ---------- */

.picker-input {
  display: flex;
  align-items: center;
  gap: 8px;
}
.picker-input input { flex: 1 1 auto; min-width: 0; }

.picker-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(2, 4, 9, 0.76);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.picker-card {
  width: min(760px, 92vw);
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 20px;
  background: #0b0f18;
  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.65);
  overflow: hidden;
}

.picker-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 24px 16px;
}
.picker-head h2 { margin: 0; font-size: 24px; letter-spacing: -0.03em; }
.picker-head p { margin: 5px 0 0; font-size: 12px; color: rgba(255, 255, 255, 0.38); }

.picker-search {
  margin: 0 24px 12px;
  height: 42px;
  padding: 0 13px;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(4, 6, 12, 0.5);
  color: #fff;
  font-size: 14px;
  outline: none;
}
.picker-search:focus { border-color: rgba(122, 162, 255, 0.7); box-shadow: 0 0 0 3px rgba(122, 162, 255, 0.12); }

.picker-status {
  padding: 0 24px 10px;
  font-size: 11px;
  color: rgba(255, 255, 255, 0.36);
}

.picker-list {
  flex: 1 1 auto;
  min-height: 120px;
  overflow-y: auto;
  padding: 0 12px 18px;
}
.picker-list::-webkit-scrollbar { width: 8px; }
.picker-list::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.12); border-radius: 4px; }

.picker-item {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  padding: 11px 12px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: #fff;
  text-align: left;
  cursor: pointer;
}
.picker-item:hover, .picker-item:focus {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
  outline: none;
}
.picker-item-main { flex: 1 1 auto; min-width: 0; }
.picker-item-main b {
  display: block;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.picker-item-main small {
  display: block;
  margin-top: 2px;
  font-size: 10px;
  color: rgba(255, 255, 255, 0.32);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.picker-item-state {
  flex: none;
  font-size: 10px;
  color: rgba(255, 255, 255, 0.4);
}
/* Aurora remote configuration UI. */
(function () {
  'use strict';

  var DEFAULTS = {
    deviceId: '',
    deviceName: 'Living Room',
    model: '',
    ha: {
      enabled: false, baseUrl: '', token: '',
      pages: [{ id: 'home', name: 'Home', widgets: [] }],
      currentPage: 'home',
      tvEntity: '', musicEntity: '', lightEntity: '', powerEntity: ''
    },
    epg: { xmltvUrl: '', demo: true, refreshMinutes: 60, horizonHours: 3 },
    sources: {
      hdmi1: { label: 'HDMI 1', sub: 'Apple TV', appId: 'org.tizen.hdmi1', haSource: 'HDMI1' },
      hdmi2: { label: 'HDMI 2', sub: 'Games console', appId: 'org.tizen.hdmi2', haSource: 'HDMI2' },
      hdmi3: { label: 'HDMI 3', sub: 'Media PC', appId: 'org.tizen.hdmi3', haSource: 'HDMI3' },
      hdmi4: { label: 'HDMI 4', sub: 'Spare input', appId: 'org.tizen.hdmi4', haSource: 'HDMI4' },
      livetv: { label: 'Live TV', sub: 'Antenna / cable', appId: 'org.tizen.tv', haSource: 'TV' }
    },
    livetv: { guideAppId: '', defaultChannel: '' },
    ui: { lastExternal: 'livetv', dashboardDuration: 30, overlayTimeoutMs: 3500 },
    remoteConfig: { enabled: false, url: '', token: '', pollMinutes: 5 }
  };

  var TOKEN_KEY = 'aurora-config-token';
  var DEVICE_KEY = 'aurora-config-device';

  var local = !!window.AURORA_LOCAL_SERVER;
  var queryToken = '';
  try { queryToken = new URLSearchParams(location.search).get('token') || ''; } catch (e) { queryToken = ''; }
  if (queryToken) sessionStorage.setItem(TOKEN_KEY, queryToken);

  var state = {
    token: queryToken || sessionStorage.getItem(TOKEN_KEY) || '',
    devices: [],
    current: null,
    config: null,
    revision: '',
    updatedAt: '',
    dirty: false,
    saving: false,
    tokenPromptOpen: false
  };

  var form = document.getElementById('form');
  var deviceList = document.getElementById('device-list');
  var title = document.getElementById('device-title');
  var meta = document.getElementById('device-meta');
  var dirtyEl = document.getElementById('dirty');
  var errorEl = document.getElementById('error-banner');
  var emptyEl = document.getElementById('empty');
  var saveBtn = document.getElementById('save');
  var serverPill = document.getElementById('server-pill');
  var serverText = document.getElementById('server-text');
  var dirtyPill = document.getElementById('dirty-pill');
  var tokenModal = document.getElementById('token-modal');
  var tokenInput = document.getElementById('token-input');
  var tokenError = document.getElementById('token-error');
  var deviceModal = document.getElementById('device-modal');
  var newError = document.getElementById('new-error');

  /* ---------- utilities ---------- */

  function esc(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function isObject(value) {
    return value && typeof value === 'object' && !Array.isArray(value);
  }

  function merge(base, over) {
    if (!isObject(over)) return base;
    var out = {};
    Object.keys(base).forEach(function (key) { out[key] = base[key]; });
    Object.keys(over).forEach(function (key) {
      if (isObject(base[key]) && isObject(over[key])) out[key] = merge(base[key], over[key]);
      else if (over[key] !== undefined) out[key] = over[key];
    });
    return out;
  }

  function getPath(obj, path) {
    return path.split('.').reduce(function (acc, key) {
      return acc == null ? undefined : acc[key];
    }, obj);
  }

  function setPath(obj, path, value) {
    var parts = path.split('.');
    var target = obj;
    for (var i = 0; i < parts.length - 1; i++) {
      if (!isObject(target[parts[i]])) target[parts[i]] = {};
      target = target[parts[i]];
    }
    target[parts[parts.length - 1]] = value;
  }

  function slug(value) {
    return String(value || '').toLowerCase().trim()
      .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 41);
  }

  function toast(message, kind) {
    var host = document.getElementById('toast-host');
    var node = document.createElement('div');
    node.className = 'toast ' + (kind || '');
    node.textContent = message;
    host.appendChild(node);
    setTimeout(function () { node.classList.add('leaving'); }, 3200);
    setTimeout(function () { if (node.parentNode) node.parentNode.removeChild(node); }, 3600);
    while (host.children.length > 3) host.removeChild(host.firstChild);
  }

  function showError(message) {
    if (!message) {
      errorEl.hidden = true;
      errorEl.textContent = '';
      return;
    }
    errorEl.hidden = false;
    errorEl.textContent = message;
  }

  function setServerStatus(ok, text) {
    serverPill.className = 'pill ' + (ok ? 'ok' : 'bad');
    serverText.textContent = text;
  }

  function markDirty() {
    state.dirty = true;
    dirtyEl.hidden = false;
    dirtyPill.hidden = false;
  }

  function clearDirty() {
    state.dirty = false;
    dirtyEl.hidden = true;
    dirtyPill.hidden = true;
  }

  function formatDate(value) {
    if (!value) return '';
    var date = new Date(value);
    return isNaN(date.getTime()) ? '' : date.toLocaleString();
  }

  /* ---------- API ---------- */

  async function api(path, options) {
    options = options || {};
    var headers = Object.assign({}, options.headers || {});
    if (options.body && !headers['Content-Type']) headers['Content-Type'] = 'application/json';
    if (state.token) headers.Authorization = 'Bearer ' + state.token;

    var res = await fetch(path, {
      method: options.method || 'GET',
      headers: headers,
      body: options.body,
      cache: 'no-store'
    });

    if (res.status === 401) {
      openTokenModal('The server rejected that token. Try again.');
      var authErr = new Error('Unauthorised');
      authErr.unauthorised = true;
      throw authErr;
    }

    var text = await res.text();
    var data = null;
    if (text) {
      try { data = JSON.parse(text); } catch (e) { data = null; }
    }
    if (!res.ok) {
      throw new Error((data && data.error) || ('Request failed (HTTP ' + res.status + ')'));
    }
    return data;
  }

  /* ---------- token ---------- */

  function openTokenModal(message) {
    tokenModal.hidden = false;
    tokenError.hidden = !message;
    tokenError.textContent = message || '';
    tokenInput.value = '';
    setTimeout(function () { tokenInput.focus(); }, 50);
  }

  function closeTokenModal() {
    tokenModal.hidden = true;
  }

  async function saveToken() {
    var value = tokenInput.value.trim();
    state.token = value;
    if (value) sessionStorage.setItem(TOKEN_KEY, value);
    else sessionStorage.removeItem(TOKEN_KEY);
    closeTokenModal();
    await boot();
  }

  /* ---------- device list ---------- */

  function renderDevices() {
    deviceList.innerHTML = state.devices.map(function (device) {
      var active = device.id === state.current ? ' active' : '';
      var initial = (device.name || device.id || '?').trim().charAt(0).toUpperCase();
      return '<button type="button" class="device-item' + active + '" data-device="' + esc(device.id) + '">' +
        '<span class="device-avatar">' + esc(initial) + '</span>' +
        '<span class="device-copy"><span class="device-name">' + esc(device.name || device.id) + '</span>' +
        '<span class="device-model">' + esc(device.model || device.id) + '</span></span>' +
        '</button>';
    }).join('');
  }

  async function loadDevices() {
    var data = await api('/api/devices');
    state.devices = (data && data.devices) || [];
    setServerStatus(true, local ? 'On-TV server online' : 'Server online');
    renderDevices();
    return state.devices;
  }

  async function loadConfig(id) {
    var data = await api('/api/config/' + encodeURIComponent(id));
    state.current = id;
    state.config = merge(JSON.parse(JSON.stringify(DEFAULTS)), data.config || {});
    delete state.config.mqtt;
    if (!state.config.deviceId) state.config.deviceId = id;
    if (!state.config.sources) state.config.sources = JSON.parse(JSON.stringify(DEFAULTS.sources));
    if (!Array.isArray(state.config.ha.pages) || !state.config.ha.pages.length) {
      state.config.ha.pages = [{ id: 'home', name: 'Home', widgets: [] }];
    }
    if (!state.config.ha.currentPage) state.config.ha.currentPage = state.config.ha.pages[0].id;
    state.revision = data.revision || '';
    state.updatedAt = data.updatedAt || '';
    localStorage.setItem(DEVICE_KEY, id);
    clearDirty();
    showError('');
    render();
    if (document.scrollingElement) document.scrollingElement.scrollTop = 0;
  }

  async function selectDevice(id, force) {
    if (!force && state.dirty && !window.confirm('Discard unsaved changes?')) {
      renderDevices();
      return;
    }
    try {
      await loadConfig(id);
    } catch (err) {
      if (!err.unauthorised) showError('Could not load ' + id + ': ' + err.message);
    }
  }

  /* ---------- form rendering ---------- */

  function value(path) {
    return getPath(state.config, path);
  }

  function inputField(path, label, options) {
    options = options || {};
    var raw = value(path);
    var type = options.type || 'text';
    var val = raw == null ? '' : raw;
    return '<label class="field' + (options.span ? ' span-2' : '') + '">' +
      '<span>' + esc(label) + '</span>' +
      '<input type="' + type + '" data-path="' + esc(path) + '" value="' + esc(val) + '"' +
      (options.placeholder ? ' placeholder="' + esc(options.placeholder) + '"' : '') +
      (options.readonly ? ' readonly' : '') +
      ' autocomplete="off" spellcheck="false">' +
      (options.hint ? '<small' + (options.warn ? ' class="warn"' : '') + '>' + esc(options.hint) + '</small>' : '') +
      '</label>';
  }


  function entityField(path, label, options) {
    options = options || {};
    var raw = value(path);
    var val = raw == null ? '' : raw;
    return '<label class="field' + (options.span ? ' span-2' : '') + '">' +
      '<span>' + esc(label) + '</span>' +
      '<div class="picker-input">' +
      '<input type="text" data-path="' + esc(path) + '" value="' + esc(val) + '"' +
      (options.placeholder ? ' placeholder="' + esc(options.placeholder) + '"' : '') +
      ' autocomplete="off" spellcheck="false">' +
      '<button type="button" class="btn ghost small" data-picker="' + esc(path) + '"' +
      ' data-domain="' + esc(options.domain || '') + '"' +
      ' data-device-classes="' + esc((options.deviceClasses || []).join(',')) + '"' +
      ' data-picker-label="' + esc(label) + '">Choose</button>' +
      '</div>' +
      (options.hint ? '<small' + (options.warn ? ' class="warn"' : '') + '>' + esc(options.hint) + '</small>' : '') +
      '</label>';
  }

  function readonlyField(label, text, hint) {
    return '<label class="field"><span>' + esc(label) + '</span>' +
      '<input type="text" value="' + esc(text) + '" readonly>' +
      (hint ? '<small>' + esc(hint) + '</small>' : '') +
      '</label>';
  }

  function selectField(path, label, options, hint) {
    var current = String(value(path) || '');
    var optionsHtml = options.map(function (item) {
      var val = typeof item === 'string' ? item : item.value;
      var text = typeof item === 'string' ? item : item.label;
      return '<option value="' + esc(val) + '"' + (String(val) === current ? ' selected' : '') + '>' + esc(text) + '</option>';
    }).join('');
    if (current && !options.some(function (item) { return String(typeof item === 'string' ? item : item.value) === current; })) {
      optionsHtml += '<option value="' + esc(current) + '" selected>' + esc(current) + '</option>';
    }
    return '<label class="field"><span>' + esc(label) + '</span>' +
      '<select data-path="' + esc(path) + '">' + optionsHtml + '</select>' +
      (hint ? '<small>' + esc(hint) + '</small>' : '') +
      '</label>';
  }

  function toggleField(path, label, hint) {
    return '<div class="toggle-row"><div class="toggle-copy"><b>' + esc(label) + '</b>' +
      (hint ? '<small>' + esc(hint) + '</small>' : '') + '</div>' +
      '<label class="switch"><input type="checkbox" data-path="' + esc(path) + '"' +
      (value(path) ? ' checked' : '') + '><span class="switch-track"></span></label></div>';
  }

  function card(titleText, description, body) {
    return '<section class="card"><div class="card-head"><h2>' + esc(titleText) + '</h2>' +
      (description ? '<p>' + esc(description) + '</p>' : '') + '</div>' +
      '<div class="card-body">' + body + '</div></section>';
  }

  function sourceCard(id, index) {
    var src = state.config.sources[id] || DEFAULTS.sources[id] || {};
    var label = id === 'livetv' ? 'Live TV' : 'HDMI ' + (index + 1);
    return '<div class="source">' +
      '<div class="source-head"><span class="source-tag">' + (id === 'livetv' ? 'TV' : 'HDMI') + '</span>' +
      '<strong>' + esc(label) + '</strong></div>' +
      '<div class="grid two">' +
      inputField('sources.' + id + '.label', 'Label', { placeholder: label }) +
      inputField('sources.' + id + '.sub', 'Sub-label', { placeholder: 'Apple TV' }) +
      inputField('sources.' + id + '.appId', 'Fallback app ID', { placeholder: 'Leave empty; TVWindow is used' }) +
      inputField('sources.' + id + '.haSource', 'Home Assistant source', { placeholder: label }) +
      '</div></div>';
  }

  function render() {
    if (!state.config) return;
    var config = state.config;
    title.textContent = config.deviceName || (local ? 'This TV' : state.current) || 'Device';
    meta.textContent = [config.model || 'Unknown model', 'ID ' + (config.deviceId || state.current),
      state.revision ? 'revision ' + state.revision : '',
      state.updatedAt ? 'saved ' + formatDate(state.updatedAt) : '']
      .filter(Boolean).join(' · ');



    var endpoint = location.origin + '/api/config/' + encodeURIComponent(state.current || '');
    var onLocalhost = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
    var bootstrap = JSON.stringify({
      remoteConfig: {
        enabled: true,
        url: endpoint,
        token: state.token || config.remoteConfig.token || '',
        pollMinutes: Number(config.remoteConfig.pollMinutes) || 5
      }
    }, null, 2);

    var html = '';
    html += card('TV', 'Identity used on the TV and in the remote config URL.',
      '<div class="grid two">' +
      inputField('deviceName', 'Name', { placeholder: 'Living Room' }) +
      inputField('model', 'Model', { placeholder: 'QE50QN90CATXXU' }) +
      inputField('deviceId', 'Device ID', { readonly: true, hint: 'Read-only. Create a new device to change it.' }) +
      '</div>');

    if (!local) {
    html += card('Remote configuration', 'Aurora fetches this profile from the config server on boot and every few minutes.',
      '<div class="grid">' + toggleField('remoteConfig.enabled', 'Poll this server', 'Enable remote configuration on the TV.') + '</div>' +
      '<div class="grid two" style="margin-top:14px">' +
      inputField('remoteConfig.url', 'Config URL (bootstrap)', { placeholder: endpoint, warn: onLocalhost, hint: onLocalhost ? 'Open this UI via the server LAN IP so the TV can reach the generated URL.' : 'One-time bootstrap value; the TV keeps its local URL/token.' }) +
      inputField('remoteConfig.token', 'Config token (bootstrap)', { type: 'password', placeholder: 'Bearer token', hint: 'One-time bootstrap value; the TV keeps its local token.' }) +
      inputField('remoteConfig.pollMinutes', 'Poll interval (minutes)', { type: 'number', placeholder: '5', hint: 'This value can be managed remotely.' }) +
      '</div>' +
      '<div class="inline-actions">' +
      '<button type="button" class="btn ghost small" data-use-server>Use this server</button>' +
      '<button type="button" class="btn ghost small" data-download>Download config.json</button>' +
      '<span class="test-result" data-test-result="remote">' + esc(endpoint) + '</span>' +
      '</div>' +
      '<details class="bootstrap"><summary>TV bootstrap snippet (paste into config.json)</summary>' +
      '<pre id="bootstrap-text">' + esc(bootstrap) + '</pre>' +
      '<div class="inline-actions"><button type="button" class="btn ghost small" data-copy-snippet>Copy snippet</button></div>' +
      '</details>');
    }

    html += card('Home Assistant', 'Native entity widgets, sensors and optional TV control through Home Assistant.',
      '<div class="grid">' + toggleField('ha.enabled', 'Home Assistant', 'Connect for entity widgets, sensors and control.') + '</div>' +
      '<div class="grid two" style="margin-top:14px">' +
      inputField('ha.baseUrl', 'URL', { placeholder: 'http://homeassistant.local:8123', span: true }) +
      inputField('ha.token', 'Long-lived token', { type: 'password', placeholder: 'eyJ…' }) +
      entityField('ha.tvEntity', 'TV media_player entity', { domain: 'media_player', placeholder: 'media_player.living_room_tv' }) +
      entityField('ha.musicEntity', 'Music media_player entity', { domain: 'media_player', placeholder: 'media_player.music_assistant' }) +
      entityField('ha.lightEntity', 'Light entity', { domain: 'light', placeholder: 'light.living_room_lamp' }) +
      entityField('ha.powerEntity', 'Power sensor entity', { domain: 'sensor', deviceClasses: ['power', 'energy'], placeholder: 'sensor.tv_plug_power' }) +
      '</div>' +
      '<p class="section-note">Entity widgets and named pages are added on the TV using <b>Add entities</b> and <b>Pages</b>.</p>' +
      (local ? '' : '<div class="inline-actions"><button type="button" class="btn ghost small" data-test="ha">Test Home Assistant</button>' +
      '<span class="test-result" data-test-result="ha"></span></div>'));

    html += card('TV guide', 'XMLTV feed used by the guide. Leave empty to keep the demo grid.',
      '<div class="grid two">' +
      inputField('epg.xmltvUrl', 'XMLTV URL', { placeholder: 'http://epg.local:8080/xmltv.xml', span: true }) +
      inputField('epg.refreshMinutes', 'Refresh interval (minutes)', { type: 'number', placeholder: '60' }) +
      inputField('epg.horizonHours', 'Visible hours', { type: 'number', placeholder: '3' }) +
      '</div>' +
      '<div class="grid" style="margin-top:14px">' + toggleField('epg.demo', 'Demo guide', 'Show sample channels when no XMLTV is configured.') + '</div>' +
      (local ? '' : '<div class="inline-actions"><button type="button" class="btn ghost small" data-test="xmltv">Test XMLTV</button>' +
      '<span class="test-result" data-test-result="xmltv"></span></div>'));

    var sources = '';
    ['hdmi1', 'hdmi2', 'hdmi3', 'hdmi4'].forEach(function (id, index) { sources += sourceCard(id, index); });
    sources += sourceCard('livetv', 4);
    html += card('Inputs', 'Labels and optional fallback app IDs used when switching sources.', sources);

    html += '<div class="footer-actions">' +
      '<button type="button" class="btn ghost" data-revert>Discard changes</button>' +
      '<button type="button" class="btn primary" data-save>Save changes</button>' +
      '</div>';

    form.innerHTML = html;
    emptyEl.hidden = true;
    form.hidden = false;
    dirtyEl.hidden = !state.dirty;
    var deleteButton = document.getElementById('delete-device');
    if (deleteButton) deleteButton.disabled = true;
  }

  /* ---------- save / revert / delete / download ---------- */

  function normalizeForSave() {
    var cfg = state.config;
    delete cfg.mqtt;
    delete cfg.ha.dashboards;
    delete cfg.ha.defaultDashboard;
    if (!Array.isArray(cfg.ha.pages) || !cfg.ha.pages.length) {
      cfg.ha.pages = [{ id: 'home', name: 'Home', widgets: [] }];
    }
    if (!cfg.ha.pages.some(function (page) { return page.id === cfg.ha.currentPage; })) {
      cfg.ha.currentPage = cfg.ha.pages[0].id;
    }
    cfg.ui.overlayTimeoutMs = Math.max(1500, Math.min(15000, Number(cfg.ui.overlayTimeoutMs) || 3500));
    cfg.epg.refreshMinutes = Math.max(5, Math.min(1440, Number(cfg.epg.refreshMinutes) || 60));
    cfg.epg.horizonHours = Math.max(1, Math.min(12, Number(cfg.epg.horizonHours) || 3));
    cfg.remoteConfig.pollMinutes = Math.max(1, Math.min(1440, Number(cfg.remoteConfig.pollMinutes) || 5));
    cfg.ha.baseUrl = String(cfg.ha.baseUrl || '').trim().replace(/\/+$/, '');
    cfg.ha.token = String(cfg.ha.token || '').trim();
    cfg.epg.xmltvUrl = String(cfg.epg.xmltvUrl || '').trim();
    cfg.remoteConfig.url = String(cfg.remoteConfig.url || '').trim();
    cfg.remoteConfig.token = String(cfg.remoteConfig.token || '').trim();
    if (cfg.remoteConfig.enabled && !cfg.remoteConfig.token && state.token &&
        cfg.remoteConfig.url.indexOf(location.origin) === 0) {
      cfg.remoteConfig.token = state.token;
    }
    return cfg;
  }

  async function saveConfig() {
    if (!state.current || state.saving) return;
    state.saving = true;
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';
    try {
      var data = await api('/api/config/' + encodeURIComponent(state.current), {
        method: 'PUT',
        body: JSON.stringify(local ? normalizeForSave() : { config: normalizeForSave() })
      });
      state.config = merge(JSON.parse(JSON.stringify(DEFAULTS)), data.config || {});
    delete state.config.mqtt;
      state.revision = data.revision || '';
      state.updatedAt = data.updatedAt || '';
      state.dirty = false;
      clearDirty();
      showError('');
      render();
      await loadDevices();
      renderDevices();
      toast('Saved. The TV will apply it on its next poll.', 'ok');
    } catch (err) {
      if (!err.unauthorised) {
        showError('Save failed: ' + err.message);
        toast('Save failed', 'bad');
      }
    } finally {
      state.saving = false;
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save changes';
    }
  }

  async function revertConfig() {
    if (!state.current) return;
    if (state.dirty && !window.confirm('Discard unsaved changes?')) return;
    try {
      await loadConfig(state.current);
      toast('Reverted to the saved config', '');
    } catch (err) {
      if (!err.unauthorised) showError('Revert failed: ' + err.message);
    }
  }

  async function deleteDevice() {
    if (!state.current) return;
    if (!window.confirm('Delete the configuration for "' + (state.config.deviceName || state.current) + '"? This cannot be undone.')) return;
    try {
      await api('/api/devices/' + encodeURIComponent(state.current), { method: 'DELETE' });
      toast('Device deleted', '');
      state.current = null;
      state.config = null;
      await loadDevices();
      if (state.devices.length) await loadConfig(state.devices[0].id);
      else showEmpty();
    } catch (err) {
      if (!err.unauthorised) showError('Delete failed: ' + err.message);
    }
  }

  async function downloadConfig() {
    if (!state.current) return;
    try {
      var res = await fetch('/api/bootstrap/' + encodeURIComponent(state.current), {
        headers: state.token ? { Authorization: 'Bearer ' + state.token } : {},
        cache: 'no-store'
      });
      if (res.status === 401) { openTokenModal('The server rejected that token.'); return; }
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var text = await res.text();
      var blob = new Blob([text], { type: 'application/json' });
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url;
      link.download = 'config-' + state.current + '.json';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
      toast('Downloaded config-' + state.current + '.json', 'ok');
    } catch (err) {
      showError('Download failed: ' + err.message);
    }
  }


  /* ---------- Home Assistant entity picker ---------- */

  function pickerMatches(entity, domain, deviceClasses) {
    if (!entity || !entity.entity_id) return false;
    if (domain && entity.entity_id.split('.')[0] !== domain) return false;
    if (!deviceClasses.length) return true;
    var attrs = entity.attributes || {};
    var deviceClass = String(attrs.device_class || '').toLowerCase();
    var unit = String(attrs.unit_of_measurement || '').toLowerCase();
    if (deviceClasses.indexOf(deviceClass) !== -1) return true;
    return deviceClasses.indexOf('power') !== -1 && ['w', 'kw', 'wh', 'kwh'].indexOf(unit) !== -1;
  }

  async function fetchPickerEntities(baseUrl, token) {
    try {
      var data = await api('/api/ha/entities', {
        method: 'POST',
        body: JSON.stringify({ baseUrl: baseUrl, token: token })
      });
      if (data && data.ok) return data.entities || [];
      if (data && data.error) throw new Error(data.error);
    } catch (e) {
      if (e && e.unauthorised) throw e;
      /* On-TV server has no HA proxy; try HA directly. */
    }
    var base = String(baseUrl || '').replace(/\/+$/, '');
    if (!/^https?:\/\//i.test(base)) throw new Error('Set the Home Assistant URL first');
    var res = await fetch(base + '/api/states', {
      headers: { 'Authorization': 'Bearer ' + token, 'Accept': 'application/json' },
      cache: 'no-store'
    });
    if (!res.ok) throw new Error('Home Assistant returned HTTP ' + res.status);
    return await res.json();
  }

  function openHaPicker(button) {
    var path = button.getAttribute('data-picker');
    var domain = button.getAttribute('data-domain') || '';
    var deviceClasses = (button.getAttribute('data-device-classes') || '').split(',').filter(Boolean);
    var label = button.getAttribute('data-picker-label') || 'Entity';
    var baseUrl = value('ha.baseUrl');
    var token = value('ha.token');
    if (!baseUrl || !token) {
      toast('Set the Home Assistant URL and token first', 'bad');
      return;
    }
    var overlay = document.createElement('div');
    overlay.className = 'picker-overlay';
    overlay.innerHTML = '<div class="picker-card">' +
      '<div class="picker-head"><div><h2>' + esc(label) + '</h2><p>Choose an entity from Home Assistant</p></div>' +
      '<button type="button" class="btn ghost small" data-picker-close>Close</button></div>' +
      '<input type="search" class="picker-search" data-picker-search placeholder="Search by name or entity ID" autocomplete="off">' +
      '<div class="picker-status" data-picker-status>Loading entities…</div>' +
      '<div class="picker-list" data-picker-list></div>' +
      '</div>';
    document.body.appendChild(overlay);
    var list = overlay.querySelector('[data-picker-list]');
    var status = overlay.querySelector('[data-picker-status]');
    var search = overlay.querySelector('[data-picker-search]');
    var all = [];
    function close() {
      if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
    }
    function render() {
      var query = String(search.value || '').trim().toLowerCase();
      var filtered = all.filter(function (entity) {
        if (!query) return true;
        var name = String((entity.attributes && entity.attributes.friendly_name) || entity.entity_id).toLowerCase();
        return name.indexOf(query) !== -1 || entity.entity_id.toLowerCase().indexOf(query) !== -1;
      });
      if (!filtered.length) {
        list.innerHTML = '<p class="section-note">No matching entities.</p>';
        return;
      }
      list.innerHTML = filtered.map(function (entity) {
        var name = (entity.attributes && entity.attributes.friendly_name) || entity.entity_id;
        return '<button type="button" class="picker-item" data-picker-entity="' + esc(entity.entity_id) + '">' +
          '<span class="picker-item-main"><b>' + esc(name) + '</b><small>' + esc(entity.entity_id) + '</small></span>' +
          '<span class="picker-item-state">' + esc(entity.state) + '</span></button>';
      }).join('');
    }
    function select(id) {
      var input = form.querySelector('[data-path="' + path.replace(/"/g, '\\"') + '"]');
      if (input) {
        input.value = id;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
      }
      close();
    }
    overlay.addEventListener('click', function (event) {
      if (event.target === overlay || event.target.closest('[data-picker-close]')) { close(); return; }
      var item = event.target.closest('[data-picker-entity]');
      if (item) select(item.getAttribute('data-picker-entity'));
    });
    search.addEventListener('input', render);
    document.addEventListener('keydown', function escape(event) {
      if (event.key === 'Escape') { close(); document.removeEventListener('keydown', escape); }
    });
    fetchPickerEntities(baseUrl, token).then(function (entities) {
      all = (entities || []).filter(function (entity) {
        return pickerMatches(entity, domain, deviceClasses);
      });
      if (!all.length && domain) {
        all = (entities || []).filter(function (entity) {
          return entity.entity_id && entity.entity_id.split('.')[0] === domain;
        });
      }
      all.sort(function (a, b) {
        var na = (a.attributes && a.attributes.friendly_name) || a.entity_id;
        var nb = (b.attributes && b.attributes.friendly_name) || b.entity_id;
        return na.localeCompare(nb);
      });
      status.textContent = all.length + (all.length === 1 ? ' entity' : ' entities');
      if (!all.length) {
        list.innerHTML = '<p class="section-note">No matching entities. Check the token and HA connection.</p>';
      } else {
        render();
      }
    }).catch(function (err) {
      status.textContent = err.message;
      list.innerHTML = '<p class="section-note">Could not load entities. If this page is served by the TV, use the on-screen Settings picker instead.</p>';
    });
  }

  /* ---------- tests ---------- */

  async function runTest(kind, button) {
    var result = form.querySelector('[data-test-result="' + kind + '"]');
    if (result) { result.className = 'test-result'; result.textContent = 'Testing…'; }
    button.disabled = true;
    try {
      var body = {};
      var endpoint = '/api/test/' + kind;
      if (kind === 'ha') body = { baseUrl: value('ha.baseUrl'), token: value('ha.token') };
      if (kind === 'xmltv') body = { url: value('epg.xmltvUrl') };
      var data = await api(endpoint, { method: 'POST', body: JSON.stringify(body) });
      if (data && data.ok) {
        var text = kind === 'ha' ? ('Connected · ' + data.count + ' entities') :
          ('XMLTV · ' + data.channels + ' channels, ' + data.programmes + ' programmes');
        result.className = 'test-result ok';
        result.textContent = text;
      } else {
        result.className = 'test-result bad';
        result.textContent = (data && data.error) || 'Test failed';
      }
    } catch (err) {
      if (!err.unauthorised && result) {
        result.className = 'test-result bad';
        result.textContent = err.message;
      }
    } finally {
      button.disabled = false;
    }
  }

  /* ---------- snippets ---------- */

  function copySnippet() {
    var pre = document.getElementById('bootstrap-text');
    if (!pre) return;
    var text = pre.textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { toast('Snippet copied', 'ok'); }, function () { toast('Could not copy', 'bad'); });
    } else {
      var area = document.createElement('textarea');
      area.value = text;
      document.body.appendChild(area);
      area.select();
      try { document.execCommand('copy'); toast('Snippet copied', 'ok'); } catch (e) { toast('Could not copy', 'bad'); }
      document.body.removeChild(area);
    }
  }

  function useThisServer() {
    var endpoint = location.origin + '/api/config/' + encodeURIComponent(state.current);
    var rc = state.config.remoteConfig;
    rc.enabled = true;
    rc.url = endpoint;
    rc.token = state.token || rc.token || '';
    if (!rc.pollMinutes) rc.pollMinutes = 5;
    markDirty();
    render();
    toast('Remote URL filled in. Save changes to apply it.', 'ok');
  }

  /* ---------- device add modal ---------- */

  function openNewDevice() {
    var copy = document.getElementById('new-copy');
    copy.innerHTML = state.devices.map(function (device) {
      return '<option value="' + esc(device.id) + '">' + esc(device.name || device.id) + '</option>';
    }).join('');
    document.getElementById('new-id').value = '';
    document.getElementById('new-name').value = '';
    document.getElementById('new-model').value = '';
    newError.hidden = true;
    deviceModal.hidden = false;
    setTimeout(function () { document.getElementById('new-id').focus(); }, 50);
  }

  async function createDevice() {
    var id = slug(document.getElementById('new-id').value);
    var name = document.getElementById('new-name').value.trim() || id;
    var model = document.getElementById('new-model').value.trim();
    var copyFrom = document.getElementById('new-copy').value;
    newError.hidden = true;
    if (!/^[a-z0-9][a-z0-9_-]{0,40}$/.test(id)) {
      newError.hidden = false;
      newError.textContent = 'Device ID must use lowercase letters, numbers, hyphen or underscore.';
      return;
    }
    if (!copyFrom) {
      newError.hidden = false;
      newError.textContent = 'Add at least one existing device first.';
      return;
    }
    try {
      await api('/api/devices', {
        method: 'POST',
        body: JSON.stringify({ id: id, name: name, model: model, copyFrom: copyFrom })
      });
      deviceModal.hidden = true;
      await loadDevices();
      await loadConfig(id);
      toast('Device created', 'ok');
    } catch (err) {
      if (!err.unauthorised) {
        newError.hidden = false;
        newError.textContent = err.message;
      }
    }
  }

  /* ---------- empty state ---------- */

  function showEmpty() {
    state.config = null;
    form.hidden = true;
    form.innerHTML = '';
    emptyEl.hidden = false;
    title.textContent = 'No device selected';
    meta.textContent = 'Add a device to get started.';
    clearDirty();
    renderDevices();
  }

  /* ---------- events ---------- */

  function handleFieldChange(event) {
    var el = event.target;
    if (el.dataset && el.dataset.path) {
      var valueToSet = el.type === 'checkbox' ? el.checked : el.value;
      setPath(state.config, el.dataset.path, valueToSet);
      markDirty();
      return;
    }
  }

  function handleFormClick(event) {
    var target = event.target.closest('button');
    if (!target) return;

    if (target.matches('[data-picker]')) { openHaPicker(target); return; }
    if (target.matches('[data-save]')) { saveConfig(); return; }
    if (target.matches('[data-revert]')) { revertConfig(); return; }
    if (target.matches('[data-download]')) { downloadConfig(); return; }
    if (target.matches('[data-use-server]')) { useThisServer(); return; }
    if (target.matches('[data-copy-snippet]')) { copySnippet(); return; }

    var test = target.getAttribute('data-test');
    if (test) { runTest(test, target); return; }

  }

  function bind() {
    form.addEventListener('input', handleFieldChange);
    form.addEventListener('change', handleFieldChange);
    form.addEventListener('click', handleFormClick);
    form.addEventListener('submit', function (event) { event.preventDefault(); });

    document.getElementById('save').addEventListener('click', saveConfig);
    document.getElementById('revert').addEventListener('click', revertConfig);
    var deleteBtn = document.getElementById('delete-device');
    if (deleteBtn) deleteBtn.addEventListener('click', deleteDevice);
    document.getElementById('download-config').addEventListener('click', downloadConfig);
    var addBtn = document.getElementById('add-device');
    if (addBtn) addBtn.addEventListener('click', openNewDevice);
    document.getElementById('empty-add').addEventListener('click', openNewDevice);
    var tokenBtn = document.getElementById('token-btn');
    if (tokenBtn) tokenBtn.addEventListener('click', function () { openTokenModal(''); });

    deviceList.addEventListener('click', function (event) {
      var button = event.target.closest('[data-device]');
      if (button) selectDevice(button.getAttribute('data-device'));
    });

    document.getElementById('token-save').addEventListener('click', saveToken);
    document.getElementById('token-cancel').addEventListener('click', function () {
      closeTokenModal();
      if (!state.devices.length) showError('An access token is required to load configurations.');
    });
    tokenInput.addEventListener('keydown', function (event) {
      if (event.key === 'Enter') saveToken();
    });

    document.getElementById('new-cancel').addEventListener('click', function () { deviceModal.hidden = true; });
    document.getElementById('new-save').addEventListener('click', createDevice);

    document.addEventListener('keydown', function (event) {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        saveConfig();
      }
      if (event.key === 'Escape') {
        if (!tokenModal.hidden) closeTokenModal();
        if (!deviceModal.hidden) deviceModal.hidden = true;
      }
    });

    window.addEventListener('beforeunload', function (event) {
      if (state.dirty) {
        event.preventDefault();
        event.returnValue = '';
      }
    });

    var nameInput = document.getElementById('new-name');
    var idInput = document.getElementById('new-id');
    nameInput.addEventListener('input', function () {
      if (!idInput.dataset.edited) idInput.value = slug(nameInput.value);
    });
    idInput.addEventListener('input', function () { idInput.dataset.edited = '1'; });
  }

  /* ---------- boot ---------- */

  async function boot() {
    try {
      showError('');
      var devices = await loadDevices();
      if (!devices.length) {
        showEmpty();
        return;
      }
      var preferred = localStorage.getItem(DEVICE_KEY);
      var exists = devices.some(function (d) { return d.id === preferred; });
      var target = exists ? preferred : (state.current && devices.some(function (d) { return d.id === state.current; }) ? state.current : devices[0].id);
      await loadConfig(target);
    } catch (err) {
      if (err.unauthorised) {
        setServerStatus(false, 'Token required');
        return;
      }
      setServerStatus(false, 'Server unreachable');
      showError('Cannot reach the config server: ' + err.message);
    }
  }

  if (local) {
    var sideHead = document.querySelector('.side-head span');
    if (sideHead) sideHead.textContent = 'This TV';
    var sideNote = document.querySelector('.side-note');
    if (sideNote) sideNote.textContent = 'Served by the TV itself on port 8099. Changes apply immediately while Aurora is running.';
    document.title = 'Aurora · On-TV configuration';
  }

  bind();
  boot();
})();
